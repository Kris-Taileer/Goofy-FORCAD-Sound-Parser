#!/usr/bin/env python3
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
action, team, *args = sys.argv[1:]
override = root / "checkers" / f"{team}.status"
status = int(override.read_text()) if override.exists() else 101
if status != 101:
    print("Lab checker status override")
    raise SystemExit(status)

if action == "put":
    _, flag, _ = args
    (root / "flags" / f"{team}-{flag}").touch()
    print(flag)
elif action == "get":
    key, flag, _ = args
    if key != flag or not (root / "flags" / f"{team}-{flag}").exists():
        print("Flag missing from test service")
        raise SystemExit(102)

raise SystemExit(101)
